# ── Log file to monitor ──
LOG_FILE_PATH=app.log

# ── Detection tuning ──
WARMUP_SECONDS=30
Z_THRESHOLD=3.5
EPSILON=0.01
MIN_ABS_CHANGE=0.05
WINDOW_SECONDS=20
BUCKET_SECONDS=10
INCIDENT_CLOSE_SECONDS=15

# ── AWS CloudWatch Configuration ──
# To use real AWS, clear AWS_ENDPOINT_URL and set your AWS keys.
# To use local moto emulator, leave AWS_ENDPOINT_URL=http://localhost:4566
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_SESSION_TOKEN=
CW_LOG_GROUP=/reddragon/anomalies
CW_LOG_STREAM=alerts
